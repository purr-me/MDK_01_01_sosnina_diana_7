<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Художества от Дианы" Height="480" Width="800" MinHeight="480" MinWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Margin="10">
            <TextBlock Text="Окружность" FontWeight="Bold" Margin="0,0,0,5"/>
            
            <TextBlock Text="Центр х:"/>
            <TextBox Name="txCircleX" Text="150" Margin="0,0,0,5"/>

            <TextBlock Text="Центр у:"/>
            <TextBox Name="txCircleY" Text="150" Margin="0,0,0,5"/>

            <TextBlock Text="Диаметр:"/>
            <TextBox Name="txCircleD" Text="120" Margin="0,0,0,5"/>

            <Button Content="Нарисовать" Click="DrawCircle_Click"/>


            <TextBlock Text="Треугольник" FontWeight="Bold" Margin="0,0,0,5"/>

            <TextBlock Text="Центр х:"/>
            <TextBox Name="txTriangleX" Text="300" Margin="0,0,0,5"/>

            <TextBlock Text="Центр у:"/>
            <TextBox Name="txTriangleY" Text="150" Margin="0,0,0,5"/>

            <TextBlock Text="Сторона 1:"/>
            <TextBox Name="txTriangle1" Text="100" Margin="0,0,0,5"/>

            <TextBlock Text="Сторона 2:"/>
            <TextBox Name="txTriangle2" Text="100" Margin="0,0,0,5"/>

            <TextBlock Text="Сторона 3:"/>
            <TextBox Name="txTriangle3" Text="100" Margin="0,0,0,5"/>

            <Button Content="Нарисовать" Click="DrawTriangle_Click" Margin="0,0,0,5"/>

            <Button Content="Очистить" Click="Clear_Click" Margin="0,0,0,5"/>
        </StackPanel>

        <Canvas Name="CoolCanvas" Grid.Column="1" Background="LightGray"/>
    </Grid>
</Window>
